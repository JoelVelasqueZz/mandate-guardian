# PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Channel3 (trychannel3.com/developers, promo code PAYPAL-HACKATHON-2026).
# Leave empty to use the offline demo catalog (responses say "source": "demo").
CHANNEL3_API_KEY=

# AI model (Gemini, key from Google AI Studio), shared by the Guardian reviewer and the Mandate buyer agent.
# Set both to enable it; leave empty to run on rules only.
# AI_MODEL is the Gemini model id, e.g. as listed in AI Studio.
AI_API_KEY=
AI_MODEL=

# Optional AG Studio licence key (a free 45-day trial key works). Read when the client is built, so set it
# before `npm run build`. Empty: the analytics window works and shows an evaluation watermark.
VITE_AG_STUDIO=

PORT=3000

# Edison PayPal integration (sandbox only)
APP_BASE_URL=http://localhost:3000
# Team-selected flow: A authorizes before capture. B is the tested fallback.
PAYPAL_PLAN=A
# Generate a private random key for the payment API, not a PayPal credential.
DEMO_API_KEY=
ENABLE_DEMO_SCENARIO=false

# Optional: PEM private key (Ed25519, PKCS8) that signs the Guardian's approval receipts.
# Empty: a new key is generated on every start, so receipts stop verifying after a restart.
# Generate one with: npm run gen:signing-key (paste the whole printed line here)
GUARDIAN_SIGNING_KEY=
