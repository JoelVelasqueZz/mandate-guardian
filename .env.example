# PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Channel3 (trychannel3.com/developers, promo code PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# AI reviewer (Gemini, key from Google AI Studio). Set both to enable it; leave empty to run on rules only.
# AI_MODEL is the Gemini model id, e.g. as listed in AI Studio.
AI_API_KEY=
AI_MODEL=

PORT=3000
