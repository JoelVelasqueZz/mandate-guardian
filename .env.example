# PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Channel3 (trychannel3.com/developers, promo code PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# AI model used by the agents (fill in once the team picks one)
AI_API_KEY=
AI_MODEL=

PORT=3000

# Edison PayPal integration (sandbox only)
APP_BASE_URL=http://localhost:3000
# Select A or B after running sandbox tests. A below is for development.
PAYPAL_PLAN=A
# Generate a private random key for the payment API, not a PayPal credential.
DEMO_API_KEY=
ENABLE_DEMO_SCENARIO=false
