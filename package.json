{
  "name": "mandate-guardian",
  "version": "0.1.0",
  "description": "Mandate & Guardian: an independent auditor agent for AI shopping agents, built on PayPal Sandbox.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
