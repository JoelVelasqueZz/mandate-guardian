{
  "name": "mandate-guardian",
  "version": "0.1.0",
  "description": "Mandate & Guardian: an independent auditor agent for AI shopping agents, built on PayPal Sandbox.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build": "tsc && vite build",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:paypal": "node --import tsx scripts/paypal-smoke.ts",
    "smoke:ai": "tsx scripts/ai-reviewer-smoke.ts",
    "smoke:channel3": "tsx scripts/channel3-smoke.ts",
    "edison:paypal": "node --import tsx scripts/edison-paypal.ts"
  },
  "dependencies": {
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
